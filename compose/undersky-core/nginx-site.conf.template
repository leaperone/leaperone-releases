server {
    listen 80;
    server_name undersky.ai www.undersky.ai dashboard.undersky.ai api.undersky.ai;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.undersky.ai;
    ssl_certificate /etc/nginx/ssl/undersky.ai/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/undersky.ai/undersky.ai.key;
    return 308 https://undersky.ai$request_uri;
}

server {
    listen 443 ssl http2;
    server_name undersky.ai;
    ssl_certificate /etc/nginx/ssl/undersky.ai/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/undersky.ai/undersky.ai.key;
    include /etc/nginx/snippets/cloudflare-real-ip.conf;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:{{WWW_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl http2;
    server_name dashboard.undersky.ai;
    ssl_certificate /etc/nginx/ssl/undersky.ai/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/undersky.ai/undersky.ai.key;
    include /etc/nginx/snippets/cloudflare-real-ip.conf;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:{{DASHBOARD_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    server_name api.undersky.ai;
    ssl_certificate /etc/nginx/ssl/undersky.ai/fullchain.cer;
    ssl_certificate_key /etc/nginx/ssl/undersky.ai/undersky.ai.key;
    include /etc/nginx/snippets/cloudflare-real-ip.conf;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 360s;
    proxy_send_timeout 360s;
    client_max_body_size 50m;

    include /etc/nginx/snippets/undersky-core-model-routes.conf;
    location = /health { proxy_pass http://127.0.0.1:{{API_PORT}}; }
    location = /ready { proxy_pass http://127.0.0.1:{{API_PORT}}; }
    location = /health/status { proxy_pass http://127.0.0.1:{{API_PORT}}; }
    location = /v1/models { proxy_pass http://127.0.0.1:{{API_PORT}}; }
    location = /openapi.json { proxy_pass http://127.0.0.1:{{API_PORT}}; }

    # Existing control-plane, payment callbacks and media workers retain their owner.
    location / { proxy_pass http://127.0.0.1:9801; }
}
